<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0.4</Version>
    <FileVersion>2.0.0.4</FileVersion>
    <AssemblyVersion>2.0.0.4</AssemblyVersion>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="backups\**" />
    <Compile Remove="**\backups\**" />
    <None Remove="backups\**" />
    <None Remove="**\backups\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="DhogGPT.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI\AethertekUI.csproj" />
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI.Dalamud\AethertekUI.Dalamud.csproj" />
    <EmbeddedResource Update="Localization\Strings_*.resx" WithCulture="false" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="images\icon.png" LogicalName="DhogGPT.images.icon.png" />
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
